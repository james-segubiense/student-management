<!DOCTYPE html>
<html>
<head>
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>Student Management System</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/students/add">Add Student</a>
    </nav>
  </header>

  <div class="container">
    <div class="toolbar">
      <form action="/students/search" method="GET">
        <input type="text" name="keyword" placeholder="Search student...">
        <button type="submit" class="btn">Search</button>
      </form>
      <a href="/students/add" class="btn">+ Add Student</a>
    </div>

    <h2>Student List</h2>
    <table>
      <tr>
        <th>ID</th>
        <th>Student ID</th>
        <th>Name</th>
        <th>Course</th>
        <th>Year</th>
        <th>Email</th>
        <th>Actions</th>
      </tr>
      <% students.forEach(student => { %>
      <tr>
        <td><%= student.id %></td>
        <td><%= student.student_id %></td>
        <td><%= student.first_name %> <%= student.last_name %></td>
        <td><%= student.course %></td>
        <td><%= student.year_level %></td>
        <td><%= student.email %></td>
        <td><form action="/students/delete/<%= student.id %>" method="POST" style="display:inline;">
      <button type="submit" class="btn btn-danger"
              onclick="return confirm('Delete this student?');">
        Delete
      </button>
    </form>
  </td>
      </tr>
      <% }); %>
    </table>
  </div>
</body>
</html>